# Orgni API server — environment configuration.
# Copy to .env and fill in what you need. Everything below is optional at the
# schema level (the server boots with none of it set, using in-memory storage
# and a deterministic reply engine); each block below says what breaks without it.

NODE_ENV=development
PORT=8080

# ---- Database --------------------------------------------------------------
# Without DATABASE_URL, product state, Microsoft identity/tenant links, and
# Teams audit logs all live in memory and are lost on restart.
DATABASE_URL=

# ---- CORS / logging / proxy -----------------------------------------------
CORS_ORIGINS=
LOG_LEVEL=info
# Number of reverse-proxy hops in front of the API (default 1). The credential
# rate limiting keys on the resolved client IP, so this must match the real
# topology or every client shares one throttle bucket.
TRUST_PROXY_HOPS=1

# ---- Auth --------------------------------------------------------------
# Registration and sign-in require DATABASE_URL above. At least one of these
# must be set in production; SESSION_SECRET is the Replit-managed convention,
# AUTH_SECRET is a local-dev override. Also signs the Microsoft Teams
# "Connect" OAuth state token.
SESSION_SECRET=
AUTH_SECRET=

# ---- Document intelligence / ontology (optional services) ------------------
DOCUMENT_INTELLIGENCE_URL=
ONTOLOGY_URL=

# ---- Microsoft Teams bot / app ----------------------------------------------
# See docs/MICROSOFT_TEAMS_SETUP.md for exactly where each of these comes from.
# Without MICROSOFT_APP_ID + MICROSOFT_APP_PASSWORD, the Teams integration is
# fully wired but inert: the "Connect Microsoft Teams" button in Settings
# stays disabled and the bot cannot authenticate real Teams traffic.
PUBLIC_BASE_URL=
APP_BASE_URL=
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TYPE=MultiTenant
MICROSOFT_APP_TENANT_ID=
TEAMS_APP_ID=

# ---- Intelligence (LLM) ------------------------------------------------
# Without ANTHROPIC_API_KEY, Orgni answers with a deterministic template
# provider (no external calls) instead of a real model.
ANTHROPIC_API_KEY=
ORGNI_MODEL=claude-opus-5

# ---- Email (member invites + password reset) ----------------------------
# Without RESEND_API_KEY, invite and password-reset emails are logged instead
# of sent. That also means nobody can recover a forgotten password, so set this
# before launch. APP_BASE_URL (above) builds the reset link.
RESEND_API_KEY=
EMAIL_FROM=
