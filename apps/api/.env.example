# Orgni API — example environment (no secrets; copy to .env for local use)
# All values are validated at boot by @workspace/config (fails fast when invalid).

NODE_ENV=development
# Azure Container Apps does NOT inject PORT — set it and match the ingress targetPort.
PORT=8080

# --- CORS (production) ---
# Comma-separated allowed origins; wildcard subdomains supported.
# Unset in production = same-origin only. Ignored in development.
# CORS_ORIGINS=https://app.orgni.olyxee.com,https://*.vercel.app

# --- Logging ---
LOG_LEVEL=info

# --- Persistence (required once wired in) ---
# DATABASE_URL=postgres://user:password@localhost:5432/orgni

# --- Release metadata (set by CI/CD, surfaced by GET /api/version) ---
# APP_VERSION=
# GIT_SHA=

# --- Future: Azure Blob Storage for uploads (API stays stateless) ---
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=
